dilation b                                                 d zeta^(1) = b ;  d zeta^(2)/2 = b*(-x*Derivative(Phi1(0, x, y, z), x) + x*Derivative(dT1(0, x, y, z), x) - y*Derivative(Phi1(0, x, y, z), y) + y*Derivative(dT1(0, x, y, z), y) - z*Derivative(Phi1(0, x, y, z), z) + z*Derivative(dT1(0, x, y, z), z))
