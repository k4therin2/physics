rotation w(eta) = w0 + w1 eta                              d zeta^(1) = 0 ;  d zeta^(2)/2 = -w0_1*y*Derivative(Phi1(0, x, y, z), z) + w0_1*y*Derivative(dT1(0, x, y, z), z) + w0_1*z*Derivative(Phi1(0, x, y, z), y) - w0_1*z*Derivative(dT1(0, x, y, z), y) + w0_2*x*Derivative(Phi1(0, x, y, z), z) - w0_2*x*Derivative(dT1(0, x, y, z), z) - w0_2*z*Derivative(Phi1(0, x, y, z), x) + w0_2*z*Derivative(dT1(0, x, y, z), x) - w0_3*x*Derivative(Phi1(0, x, y, z), y) + w0_3*x*Derivative(dT1(0, x, y, z), y) + w0_3*y*Derivative(Phi1(0, x, y, z), x) - w0_3*y*Derivative(dT1(0, x, y, z), x)
